        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    classDef entity fill:#ffffff,stroke:#2c3e50,stroke-width:2px,rx:10,ry:10,color:#1a1a1a\n    classDef restricted fill:#fff5f5,stroke:#c0392b,stroke-width:2px,rx:10,ry:10,color:#900c3f\n\n    %% Внешние акторы и легаси\n    Operator[\&quot;Клиентский интерфейс&lt;br/&gt;оператора / врача\&quot;]:::entity\n    Client[\&quot;Клиент экосистемы\&quot;]:::entity\n    Analyst[\&quot;Бизнес-пользователь /&lt;br/&gt;Головной офис\&quot;]:::entity\n    Partners[\&quot;Новые партнеры&lt;br/&gt;(Фарма и Электроника)\&quot;]:::entity\n    Legacy[\&quot;Legacy DWH&lt;br/&gt;(MS SQL 2008)\&quot;]:::entity\n\n    %% Домен 1: Медицина\n    subgraph MedDomain [\&quot;Медицинский домен (Закрытый контур)\&quot;]\n        MedApp[\&quot;Сервисы клиник\&quot;]:::entity\n        MedDB[\&quot;Медицинское хранилище&lt;br/&gt;(PostgreSQL + S3)\&quot;]:::restricted\n    end\n\n    %% Домен 2: Финтех\n    subgraph FinDomain [\&quot;Финтех-домен\&quot;]\n        FinApp[\&quot;Финтех-сервисы&lt;br/&gt;(Банковский контур)\&quot;]:::entity\n    end\n\n    %% Домен 3: ИИ\n    subgraph AIDomain [\&quot;Домен ИИ\&quot;]\n        AIApp[\&quot;ИИ-сервисы&lt;br/&gt;(Диагностика и ML)\&quot;]:::entity\n    end\n\n    %% Домен 4: Аналитика\n    subgraph DataDomain [\&quot;Платформенный аналитический домен (Data Mesh)\&quot;]\n        Kafka[\&quot;Брокер событий&lt;br/&gt;(Apache Kafka)\&quot;]:::entity\n        Airflow[\&quot;Оркестратор ETL/ELT&lt;br/&gt;(Apache Airflow)\&quot;]:::entity\n        Lake[\&quot;Data Lake&lt;br/&gt;(S3 + Iceberg)\&quot;]:::entity\n        CH[\&quot;Аналитические витрины&lt;br/&gt;(ClickHouse)\&quot;]:::entity\n        DataHub[\&quot;Каталог данных&lt;br/&gt;(DataHub)\&quot;]:::entity\n        BI[\&quot;Портал самообслуживания&lt;br/&gt;(Apache Superset)\&quot;]:::entity\n    end\n\n    %% Потоки данных (подписи на стрелках строго про данные)\n    Operator &lt;--&gt;|\&quot;Медицинские данные,&lt;br/&gt;снимки, назначения\&quot;| MedApp\n    MedApp &lt;--&gt;|\&quot;Медкарты, истории болезней,&lt;br/&gt;результаты исследований (НЕ в BI)\&quot;| MedDB\n    MedApp &lt;--&gt;|\&quot;Обезличенные снимки ↔&lt;br/&gt;ИИ-подсказки\&quot;| AIApp\n\n    Client &lt;--&gt;|\&quot;Заявки на кредиты,&lt;br/&gt;платежи, счета\&quot;| FinApp\n    MedApp &lt;--&gt;|\&quot;Данные о счетах и&lt;br/&gt;статусах оплаты\&quot;| FinApp\n\n    MedApp --&gt;|\&quot;Обезличенные события&lt;br/&gt;(визиты, инвентарь, персонал)\&quot;| Kafka\n    FinApp --&gt;|\&quot;Финансовые события&lt;br/&gt;(транзакции, кредиты, выручка)\&quot;| Kafka\n    Partners --&gt;|\&quot;Остатки лекарств,&lt;br/&gt;телеметрия оборудования\&quot;| Kafka\n\n    Kafka --&gt;|\&quot;Поток телеметрии\&quot;| AIApp\n    Kafka --&gt;|\&quot;События в реальном времени\&quot;| CH\n    Kafka --&gt;|\&quot;Сырые события\&quot;| Airflow\n\n    Legacy --&gt;|\&quot;Исторические данные&lt;br/&gt;(кроме медкарт)\&quot;| Airflow\n    Airflow --&gt;|\&quot;Обезличенная история\&quot;| Lake\n    Lake --&gt;|\&quot;Датасеты для обучения ML\&quot;| AIApp\n    Airflow --&gt;|\&quot;Агрегированные витрины&lt;br/&gt;(без медкарт)\&quot;| CH\n\n    CH --&gt;|\&quot;Метаданные и схемы\&quot;| DataHub\n    Lake --&gt;|\&quot;Метаданные датасетов\&quot;| DataHub\n    DataHub --&gt;|\&quot;Права доступа (RBAC) и&lt;br/&gt;описание витрин\&quot;| BI\n    CH --&gt;|\&quot;Данные витрин\&quot;| BI\n    Analyst &lt;--&gt;|\&quot;Запросы срезов ↔&lt;br/&gt;отчеты и дашборды\&quot;| BI\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="DjTLKRXdpsfPv4msdXUl-133">
